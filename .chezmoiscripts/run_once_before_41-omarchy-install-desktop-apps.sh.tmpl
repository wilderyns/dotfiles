{{- $profile := includeTemplate "platform/profile.tmpl" . -}}
{{- if eq $profile "arch" -}}
#!/usr/bin/env bash
set -euo pipefail

if ! command -v omarchy >/dev/null 2>&1; then
  echo "Arch Linux detected without Omarchy; skipping Omarchy desktop applications."
  exit 0
fi

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/omarchy"
mkdir -p "$state_dir"

ensure_omarchy_install() {
  local marker="$1"
  local package="$2"
  shift 2

  if [[ -f "$state_dir/$marker" ]] && pacman -Q "$package" >/dev/null 2>&1; then
    echo "$package is already installed and configured by Omarchy."
    return
  fi

  "$@"
  touch "$state_dir/$marker"
}

# Run these before chezmoi writes its target files. Omarchy may seed application
# defaults here; the managed VS Code files then win. Ghostty and Neovim stay
# under Omarchy's control so their live desktop theme integration keeps working.
ensure_omarchy_install ghostty-v1 ghostty \
  omarchy install terminal ghostty
ensure_omarchy_install firefox-v1 firefox \
  omarchy install browser firefox
ensure_omarchy_install vscode-v1 visual-studio-code-bin \
  omarchy install editor vscode
ensure_omarchy_install 1password-v1 1password \
  omarchy install service 1password
{{- end }}
