{
  // General editor behaviour
  "editor.accessibilitySupport": "on",
  "editor.foldingMaximumRegions": 65000,
  "editor.formatOnSave": true,

  // Accessibility
  "accessibility.signalOptions.volume": 0,

  // Appearance
  "workbench.colorTheme": "Catppuccin Frappé",
  "workbench.iconTheme": "catppuccin-frappe",
  "editor.fontFamily": "Monaspace Neon Var, Fira Code, Monaco, monospace",
  "editor.fontSize": 16,
  "editor.fontVariations": "'wght' 350",
  "editor.fontLigatures": "'calt', 'liga', 'ss03', 'ss04', 'ss06'",
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment",
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": "storage,entity,variable",
        "settings": {
          "fontStyle": ""
        }
      }
    ]
  },

  // Terminal
  "terminal.integrated.fontFamily": "Monaspace Neon Var, Fira Code, Monaco, monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontWeight": 500,
  "terminal.integrated.fontWeightBold": 800,

  // JSON schemas
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://raw.githubusercontent.com": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true
  },

  // Dart
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [80],
    "editor.selectionHighlight": false,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off"
  },

  // Ruby
  "[ruby]": {
    "editor.defaultFormatter": "testdouble.vscode-standard-ruby",
    "editor.formatOnSave": true
  },
  "rubyLsp.addonSettings": {},
  "rubyLsp.rubyVersionManager": {
    "identifier": "mise",
    "miseExecutablePath": "{{ .chezmoi.homeDir }}/.local/bin/mise"
  },
  "rubyLsp.formatter": "none",
  "rubyLsp.linters": [],
  "standardRuby.mode": "onlyRunGlobally",
  "standardRuby.commandPath": "${userHome}/.local/share/mise/shims/standardrb",
  "standardRuby.autofix": true,

  // ERB
  "[erb]": {
    "editor.defaultFormatter": "aliariff.vscode-erb-beautify",
    "editor.formatOnSave": true
  },
  "languageServerHerb.formatter.enabled": true,
  "languageServerHerb.linter.enabled": true,

  // Class Collapse
  "class-collapse.functionality.enable": true,
  "class-collapse.functionality.openCollapseOnLineSelected": true,
  "class-collapse.languages.supportedLanguages": [
    "astro",
    "erb",
    "html",
    "html-erb",
    "javascript",
    "javascriptreact",
    "markdown",
    "php",
    "svelte",
    "typescript",
    "typescriptreact",
    "vue",
    "vue-html"
  ],
  "class-collapse.regex.regex": "(?<![\\w-])class\\s*(?:=|:)\\s*(?:\"((?:\\\\[\\s\\S]|[^\"\\\\])*)\"|'((?:\\\\[\\s\\S]|[^'\\\\])*)')",
  "class-collapse.regex.regexFlags": "g",
  "class-collapse.regex.regexGroups": [
    1,
    2
  ]
}
