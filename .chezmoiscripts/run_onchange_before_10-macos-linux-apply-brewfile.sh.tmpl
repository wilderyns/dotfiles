{{- $profile := includeTemplate "platform/profile.tmpl" . -}}
{{- if or (eq $profile "macos") (eq $profile "bazzite") (eq $profile "linux") -}}
#!/usr/bin/env bash
set -euo pipefail

# Brewfile hash: {{ include "Brewfile" | sha256sum }}

if command -v brew >/dev/null 2>&1; then
  brew_bin="$(command -v brew)"
elif [[ -x /opt/homebrew/bin/brew ]]; then
  brew_bin=/opt/homebrew/bin/brew
elif [[ -x /usr/local/bin/brew ]]; then
  brew_bin=/usr/local/bin/brew
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  brew_bin=/home/linuxbrew/.linuxbrew/bin/brew
else
  echo "Homebrew is required before applying the Brewfile." >&2
  exit 1
fi

eval "$("$brew_bin" shellenv)"
brew bundle --file={{ joinPath .chezmoi.sourceDir "Brewfile" | quote }}
{{- end }}
