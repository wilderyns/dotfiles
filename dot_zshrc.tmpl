# Keep user-installed tools available before initializing shell integrations.
export PATH="$HOME/.local/bin:$PATH"

{{- if eq .chezmoi.os "darwin" }}
# GUI-launched macOS terminals do not always inherit the login-shell Homebrew PATH.
if (( ! $+commands[brew] )); then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi
{{- end }}

# Oh My Zsh provides plugins and shell conveniences. Starship owns the prompt.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
plugins=(git opentofu docker docker-compose)

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

export EDITOR="nvim"
export VISUAL="$EDITOR"
alias vim="nvim"

# Work on and synchronize the chezmoi source repository.
dots() {
  local source_dir action home_status line import_diff import_answer source_status commit_message
  local -a import_paths
  source_dir="$(chezmoi source-path)" || return
  action="${1:-}"

  case "$action" in
    "")
      cd "$source_dir" || return
      ;;
    diff)
      shift
      chezmoi --no-pager diff "$@"
      ;;
    apply|update)
      shift
      if [[ "$action" == update ]]; then
        print "Pulling updates into the dotfiles repo, then applying them to your home folder."
      else
        print "Applying files from the dotfiles repo to your home folder."
      fi
      print "If asked about a home file you edited, choose diff to review it or skip to keep it."
      chezmoi --no-pager "$action" "$@"
      ;;
    push)
      shift
      if (( $# != 0 )); then
        print -u2 "Usage: dots push"
        return 2
      fi

      # The first status column identifies changes made in the home folder.
      home_status="$(chezmoi --color=false status --include=files --path-style=absolute)" || return
      for line in "${(@f)home_status}"; do
        case "$line" in
          [AM]M\ *) import_paths+=("${line:3}") ;;
        esac
      done

      if (( ${#import_paths} )); then
        import_diff="$(chezmoi --no-pager --interactive=false --dry-run --verbose re-add -- "${import_paths[@]}")" || return
        if [[ -n "$import_diff" ]]; then
          print "Managed files edited in your home folder:"
          print -r -- "$import_diff"
          read -r "import_answer?Replace the repo versions shown with your home edits? [y/N] " || return
          if [[ "${import_answer:l}" == y || "${import_answer:l}" == yes ]]; then
            chezmoi --no-pager --interactive=false re-add -- "${import_paths[@]}" || return
          fi
        fi
      fi

      source_status="$(git --no-pager -C "$source_dir" status --short --untracked-files=all)" || return
      if [[ -z "$source_status" ]]; then
        print "No dotfile changes to commit."
        return 0
      fi

      print "Dotfiles repo changes to commit:"
      print -r -- "$source_status"
      print

      if ! read -r "commit_message?Commit message: "; then
        print -u2 "Commit cancelled."
        return 1
      fi
      if [[ -z "${commit_message//[[:space:]]/}" ]]; then
        print -u2 "Commit message cannot be empty."
        return 1
      fi

      git -C "$source_dir" add -A || return
      git -C "$source_dir" commit -m "$commit_message" || return
      git -C "$source_dir" push
      ;;
    help|-h|--help)
      print "Usage:"
      print "  dots                 Change to the chezmoi source directory"
      print "  dots <editor>        Open the source directory in an editor"
      print "  dots diff            Preview unapplied changes"
      print "  dots apply           Copy managed files from the repo to your home folder"
      print "  dots update          Pull remote changes and apply them to your home folder"
      print "  dots push            Review home edits, then commit and push repo changes"
      ;;
    *)
      "$@" "$source_dir"
      ;;
  esac
}

{{- if eq .chezmoi.os "darwin" }}

# macOS development tools.
export ANDROID_HOME="$HOME/Library/Android/sdk"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH"
export PATH="/Applications/Postgres.app/Contents/Versions/latest/bin:$PATH"
{{- end }}

# mise is installed in user space by https://mise.run/zsh.
if [[ -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate zsh)"
fi

if (( $+commands[fzf] )); then
  source <(fzf --zsh)
fi

if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

# Starship is installed by the platform package manager when available.
if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
fi
