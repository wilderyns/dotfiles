{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

# Flatpak manifest hash: {{ include "dot_config/dotfiles/flatpaks.txt" | sha256sum }}

if ! command -v flatpak >/dev/null 2>&1; then
  echo "Flatpak is not installed; skipping graphical applications."
  exit 0
fi

manifest="$HOME/.config/dotfiles/flatpaks.txt"
flathub_url=https://dl.flathub.org/repo/flathub.flatpakrepo

if ! flatpak --system remotes --columns=name | grep -Fxq flathub; then
  flatpak --system remote-add --if-not-exists flathub "$flathub_url"
fi

apps=()
while IFS= read -r app_id; do
  [[ -z "$app_id" || "$app_id" == \#* ]] && continue
  apps+=("$app_id")
done < "$manifest"

if (( ${#apps[@]} == 0 )); then
  echo "No Flatpak applications are configured."
  exit 0
fi

# Make Flatpak's exported desktop entries visible to this process and to
# services started by the current Plasma/systemd user session.
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
prepend_xdg_data_dir() {
  case ":$XDG_DATA_DIRS:" in
    *":$1:"*) ;;
    *) XDG_DATA_DIRS="$1:$XDG_DATA_DIRS" ;;
  esac
}
prepend_xdg_data_dir /var/lib/flatpak/exports/share
prepend_xdg_data_dir "$HOME/.local/share/flatpak/exports/share"
export XDG_DATA_DIRS

flatpak --system install \
  --app \
  --assumeyes \
  --noninteractive \
  --or-update \
  flathub \
  "${apps[@]}"

if command -v systemctl >/dev/null 2>&1; then
  systemctl --user set-environment XDG_DATA_DIRS="$XDG_DATA_DIRS" || true
fi
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd XDG_DATA_DIRS || true
fi

# Plasma normally notices new desktop entries automatically, but a forced
# service-cache rebuild makes newly installed Flatpaks appear immediately.
if command -v kbuildsycoca6 >/dev/null 2>&1; then
  kbuildsycoca6
elif command -v kbuildsycoca5 >/dev/null 2>&1; then
  kbuildsycoca5
fi
{{- end }}
