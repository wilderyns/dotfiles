# Keep user-installed tools available before initializing shell integrations.
export PATH="$HOME/.local/bin:$PATH"

# GUI-launched terminals do not always inherit the login-shell Homebrew PATH.
if (( ! $+commands[brew] )); then
{{- if eq .chezmoi.os "darwin" }}
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
{{- else if eq .chezmoi.os "linux" }}
  if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  fi
{{- end }}
fi

# Oh My Zsh provides plugins and shell conveniences. Starship owns the prompt.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
plugins=(git opentofu docker docker-compose)

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

export EDITOR="nvim"
export VISUAL="$EDITOR"
alias vim="nvim"

# Work on and synchronize the chezmoi source repository.
dots() {
  local source_dir action commit_message
  source_dir="$(chezmoi source-path)" || return
  action="${1:-}"

  case "$action" in
    "")
      cd "$source_dir" || return
      ;;
    diff|apply|update)
      shift
      chezmoi "$action" "$@"
      ;;
    push)
      shift
      if (( $# != 0 )); then
        print -u2 "Usage: dots push"
        return 2
      fi

      # Import approved changes from managed, non-template files first.
      chezmoi re-add --interactive || return
      git -C "$source_dir" add -A || return

      if git -C "$source_dir" diff --cached --quiet; then
        print "No dotfile changes to commit."
        return 0
      fi

      print "Changes to commit:"
      git -C "$source_dir" status --short
      git -C "$source_dir" diff --cached --stat
      print

      if ! read "commit_message?Commit message: "; then
        print -u2 "Commit cancelled."
        return 1
      fi
      if [[ -z "${commit_message//[[:space:]]/}" ]]; then
        print -u2 "Commit message cannot be empty."
        return 1
      fi

      git -C "$source_dir" commit -m "$commit_message" || return
      git -C "$source_dir" push
      ;;
    help|-h|--help)
      print "Usage:"
      print "  dots                 Change to the chezmoi source directory"
      print "  dots <editor>        Open the source directory in an editor"
      print "  dots diff            Preview unapplied changes"
      print "  dots apply           Apply source changes"
      print "  dots update          Pull and apply remote changes"
      print "  dots push            Re-add, commit, and push local changes"
      ;;
    *)
      "$@" "$source_dir"
      ;;
  esac
}

{{- if eq .chezmoi.os "darwin" }}

# macOS development tools.
export ANDROID_HOME="$HOME/Library/Android/sdk"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH"
export PATH="/Applications/Postgres.app/Contents/Versions/latest/bin:$PATH"
{{- end }}

# mise is installed in user space by https://mise.run/zsh.
if [[ -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate zsh)"
fi

# Starship is installed by Homebrew on both macOS and Linux.
if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
fi
